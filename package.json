{
  "name": "satisfactory-calculator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Satisfactory production chain calculator",
  "license": "MIT",
  "scripts": {
    "dev": "rsbuild dev --open",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts \"*.{ts,mjs,json}\"",
    "data:catalog": "node scripts/catalog/build-catalog.ts",
    "data:icons": "node scripts/catalog/fetch-icons.ts",
    "visual:shots": "node scripts/visual/screenshots.ts",
    "visual:compare": "node scripts/visual/compare.ts"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-preact": "^1.7.3",
    "@shahimat/ai-core": "0.1.1",
    "@shahimat/cli": "0.1.1",
    "@shahimat/harness": "0.4.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.1.12"
  }
}
