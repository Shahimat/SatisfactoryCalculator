@startuml

' Модель хранения в браузере: сервера нет.
' Каталог игры — только чтение, id из игры; сущности пользователя — uuid.
hide circle

package "каталог игры — только чтение (id из игры)" {
  entity Item {
    *id : string (ClassName)
    ..
    name : string
    energyMJ : number
    kind : string
  }

  entity Building {
    *id : string (ClassName)
    ..
    name : string
    powerMW : number
    powerExponent : number
    somersloopSlots : number
    somersloopPowerExponent : number
    extraction : cycleSeconds, amountPerCycle | нет
    generation : powerMW, fuels | нет
  }

  entity Recipe {
    *id : string (ClassName)
    ..
    building : string
    cycleSeconds : number
    inputs : [item, amount за цикл]
    outputs : [item, amount за цикл]
    variablePowerMW : constant, factor | нет
  }
}

package "данные пользователя — uuid" {
  entity Calculation {
    *id : uuid
    ..
    name : string
    goals : [{item id, perMinute}]
    solver : sequential | matrix
    built : number (0 = черновик)
    gameVersion : string
    recipeSignatures : map recipe id → signature
    rows : [Row]
  }

  entity Workshop {
    *id : uuid
    ..
    name : string
    goals : [{item id, perMinute}]
    solver : sequential | matrix
    gameVersion : string
    recipeSignatures : map recipe id → signature
    rows : [Row]
  }

  entity BuildingGroup {
    ..
    count : number (решатель даёт целое — ровный разгон у всех зданий)
    clock : number (0.01–2.5)
    somersloops : number
  }

  entity RecipeRow {
    *id : string
    ..
    recipe : string
    sizing : auto | fixed
    output : {item, perMinute} | нет
    groups : [BuildingGroup]
  }

  entity ExtractorRow {
    *id : string
    ..
    building : string
    resource : string
    purity : impure | normal | pure
    sizing : auto | fixed
    output : {item, perMinute} | нет
    groups : [BuildingGroup]
  }

  entity GeneratorRow {
    *id : string
    ..
    building : string
    fuel : string
    groups : [BuildingGroup]
  }

  entity WorkshopRow {
    *id : string
    ..
    workshop : uuid
    copies : number
  }

  entity PlantRow {
    *id : string
    ..
    calculation : uuid
    copies : number
  }
}

note as Storage
  localStorage: 'satisfactory-calculator/state', schema: 1
  AppState: calculations, workshops, units (ipm | 1–6)
  Экспорт: format 'satisfactory-calculator', schema 1,
  gameVersion, exportedAt, calculations, workshops
  Импорт сопоставляет по uuid; копия получает новый uuid
end note

Recipe }o--|| Building : building
RecipeRow }o--|| Recipe : recipe
ExtractorRow }o--|| Item : resource
GeneratorRow }o--|| Item : fuel
Calculation ||--o{ RecipeRow
Calculation ||--o{ ExtractorRow
Calculation ||--o{ GeneratorRow
Calculation ||--o{ WorkshopRow
Calculation ||--o{ PlantRow
Workshop ||--o{ RecipeRow
Workshop ||--o{ ExtractorRow
Workshop ||--o{ GeneratorRow
Workshop ||--o{ WorkshopRow
WorkshopRow }o--|| Workshop : workshop
PlantRow }o--|| Calculation : calculation
RecipeRow ||--|{ BuildingGroup
ExtractorRow ||--|{ BuildingGroup
GeneratorRow ||--|{ BuildingGroup

@enduml
