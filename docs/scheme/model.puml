@startuml

' hide the spot
hide circle

' avoid problems with angled crows feet
' skinparam linetype ortho

entity item_type {
  *id : number
  ..
  name: string
}

entity item_category {
  *id : number
  is_internal_energy: boolean
  ..
  name: string
}

entity icon_category {
  *id : number
  ..
  name: string
}

entity icon {
  *id : number
  ..
  name: string
  path: string
  +id_icon_category: number
}

entity item {
  *id : number
  ..
  name: string
  +id_icon: number
  +id_item_type: number
  +id_item_category: number
  energy: number (>= 0) | 0
}

entity factory {
  *id : number
  ..
  name: string
  +id_icon: number
  consumption: number (>= 0)
  is_scheme_generation: boolean
  is_scheme_consumption: boolean
  is_acceleration: boolean
  tier: number
  input_solid: number (0, 1, 2, 3, 4)
  input_liquid: number (0, 1, 2, 3, 4)
  input_other: number (0, 1)
  output_solid: number (0, 1, 2, 3, 4)
  output_liquid: number (0, 1, 2, 3, 4)
  output_other: number (0, 1)
}

entity scheme {
  *id : number
  ..
  name: string
  +id_factory: number
  generation: number (+-) | 0
}

entity scheme_item_link {
  *id : number
  ..
  +id_scheme: number
  +id_item: number
  production: number (+-)
}

entity plant {
  *id : number
  ..
  name: string
}

entity chain {
  *id : number
  ..
}

entity calculation {
  *id : number
  ..
  name: string
}

entity plant_scheme_link {
  *id : number
  ..
  +id_plant: number
  +id_scheme: number
  acceleration: number (0.01...1...2.5)
  num_factories: number (1, 2, ..., n)
}

entity plant_chain_link {
  *id : number
  ..
  +id_plant: number
  +id_chain: number
  num_chains: number (1, 2, ..., n)
}

entity plant_plant_link {
  *id : number
  ..
  +id_plant: number
  +id_plant_wildcard: number
  num_plants: number (1, 2, ..., n)
}

entity chain_scheme_link {
  *id : number
  ..
  +id_chain: number
  +id_scheme: number
  acceleration: number (0.01...1...2.5)
  num_factories: number (1, 2, ..., n)
}

entity chain_plant_link {
  *id : number
  ..
  +id_chain: number
  +id_plant: number
  num_plants: number (1, 2, ..., n)
}

entity calculation_scheme_link {
  *id : number
  ..
  +id_calculation: number
  +id_scheme: number
  acceleration: number (0.01...1...2.5)
  num_factories: number (1, 2, ..., n)
}

entity calculation_chain_link {
  *id : number
  ..
  +id_calculation: number
  +id_chain: number
  num_chains: number (1, 2, ..., n)
}

entity calculation_plant_link {
  *id : number
  ..
  +id_calculation: number
  +id_plant: number
  num_plants: number (1, 2, ..., n)
}

icon_category ||..|{ icon
icon ||..o{ item
item_type ||..|{ item
item_category ||..|{ item
icon ||..o{ factory
factory ||..|{ scheme
item ||..o{ scheme_item_link
scheme ||..o{ scheme_item_link

calculation ||..o{ calculation_scheme_link
scheme ||..o{ calculation_scheme_link
calculation ||..o{ calculation_chain_link
chain ||..o{ calculation_chain_link
calculation ||..o{ calculation_plant_link
plant ||..o{ calculation_plant_link

chain ||..o{ chain_scheme_link
scheme ||..o{ chain_scheme_link
chain ||..o{ chain_plant_link
plant ||..o{ chain_plant_link

plant ||..o{ plant_scheme_link
scheme ||..o{ plant_scheme_link
plant ||..o{ plant_chain_link
chain ||..o{ plant_chain_link
plant ||..o{ plant_plant_link
plant ||..o{ plant_plant_link

@enduml
